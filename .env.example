REDIS_HOST=127.0.0.1
REDIS_PORT=6379
NOTIFY_KEY_PREFIX=taey

# Optional systemd launch keys used by deploy/systemd/conductor-notify-router.service.
# These are required by that unit file and fail loud if omitted from its env file.
# NOTIFY_REPO_ROOT=/absolute/path/to/claude-code-fleet-notify
# NOTIFY_PYTHON=/usr/bin/python3

# Optional explicit session/node id override for CLI use.
# TAEY_NODE_ID=session-a

# Required if `lib.orch_schema` and `lib.config` are not already importable from
# an installed fleet-orchestrator package.
# ORCH_REPO_ROOT=/absolute/path/to/claude-code-fleet-orchestrator

# Tasks API base used by Stage B hook integration and helper CLIs.
ORCH_API_BASE=http://127.0.0.1:5002

# Optional orchestrator/dashboard keys commonly shared with hook subprocesses.
# The notify daemon does not require the graph store keys to start; they are
# present here so operator dotenvs can be mirrored by key name without copying
# private values.
# ORCH_DASHBOARD_URL=http://127.0.0.1:5002
# ORCH_REDIS_HOST=127.0.0.1
# ORCH_REDIS_PORT=6379
# ORCH_NEO4J_URI=bolt://127.0.0.1:7687
# ORCH_NEO4J_DB=neo4j

# Optional support-repo checkout used only when Stage B opens a bug lock after
# repeated engine errors.
# CF_SUPPORT_REPO_ROOT=/absolute/path/to/claude-code-fleet-support

# Optional handoff controls. Leave unset unless you are deliberately enabling
# strict or passive handoff acknowledgement behavior for named sessions.
# CF_HANDOFF_ENFORCE=1
# CF_HANDOFF_ENFORCE_SESSIONS=supervisor-codex
# CF_HANDOFF_ACK_PASSIVE=1
# CF_HANDOFF_ACK_PASSIVE_SESSIONS=supervisor-codex

# Optional Stage B activation controls.
# CF_STAGE_B_ENABLED=1
# CF_STAGE_B_MARKER_PATH=$HOME/.taey/stage_b_enabled

# Optional live-path guard registry. The hook default is the conductor-owned
# registry at /home/mira/the-conductor/config/live_path_registry.json.
# CF_LIVE_PATH_REGISTRY=/absolute/path/to/live_path_registry.json

# Optional deploy-script overrides.
# LIVE_PATH=$HOME/.local/share/claude-code-fleet-notify/live
# VERSION_ROOT=$HOME/.local/share/claude-code-fleet-notify/versions
# DEPLOY_LOG=$HOME/.taey/deploy-log.jsonl
# DAEMON_CONTROL=/absolute/path/to/start_notify_daemons.sh
# SOURCE_REPO=/absolute/path/to/claude-code-fleet-notify

# Optional Stage B integration-test override.
# STAGE_A_TEST_ORCH_ROOT=/absolute/path/to/claude-code-fleet-orchestrator
