#!/usr/bin/env python3
from __future__ import annotations

import argparse

from _stage_b_api import api_call, print_json


def cmd_set(args: argparse.Namespace) -> None:
    payload = {
        "priority": args.priority,
        "reason": args.reason,
        "set_by": args.set_by,
        "source_surface": "cli",
    }
    result = api_call("PATCH", f"/api/projects/{args.project_id}", payload)
    print(f"OK: priority for {args.project_id} set to {args.priority}")
    print_json(result)


def cmd_history(args: argparse.Namespace) -> None:
    result = api_call("GET", f"/api/projects/{args.project_id}")
    print_json({"project_id": args.project_id, "priority_history": result["project"].get("priority_history", [])})


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command")

    p_set = sub.add_parser("set")
    p_set.add_argument("project_id")
    p_set.add_argument("priority", type=int)
    p_set.add_argument("--reason", required=True)
    p_set.add_argument("--set-by", default="taey-priority")
    p_set.set_defaults(func=cmd_set)

    p_history = sub.add_parser("history")
    p_history.add_argument("project_id")
    p_history.set_defaults(func=cmd_history)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.error("choose set or history")
    args.func(args)


if __name__ == "__main__":
    main()
