#!/usr/bin/env python3
from __future__ import annotations

import argparse

from _stage_b_api import api_call, current_session, print_json, resolve_condition


def cmd_set(args: argparse.Namespace) -> None:
    project = api_call("GET", f"/api/projects/{args.project_id}")
    condition = resolve_condition(project, args.condition)
    payload = {
        "condition_id": condition["id"],
        "condition_version": condition["version"],
        "detail": args.detail,
        "from": args.session or current_session(),
    }
    result = api_call("POST", f"/api/projects/{args.project_id}/stop-reason", payload)
    print(f"OK: set stop_reason on {args.project_id} using {condition['label']} [{condition['id']} v{condition['version']}]")
    print_json(result)


def cmd_clear(args: argparse.Namespace) -> None:
    result = api_call("DELETE", f"/api/projects/{args.project_id}/stop-reason", {"from": args.session or current_session()})
    print(f"OK: cleared stop_reason on {args.project_id}")
    print_json(result)


def cmd_status(args: argparse.Namespace) -> None:
    if args.project:
        print_json(api_call("GET", f"/api/projects/{args.project}"))
        return
    session = args.session or current_session()
    print_json(api_call("GET", f"/api/sessions/{session}/stop-status"))


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command")

    p_set = sub.add_parser("set")
    p_set.add_argument("project_id")
    p_set.add_argument("--condition", required=True)
    p_set.add_argument("--detail", required=True)
    p_set.add_argument("--session", default=None)
    p_set.set_defaults(func=cmd_set)

    p_clear = sub.add_parser("clear")
    p_clear.add_argument("project_id")
    p_clear.add_argument("--session", default=None)
    p_clear.set_defaults(func=cmd_clear)

    p_status = sub.add_parser("status")
    p_status.add_argument("--project", default=None)
    p_status.add_argument("--session", default=None)
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.error("choose set, clear, or status")
    args.func(args)


if __name__ == "__main__":
    main()
