#!/usr/bin/env python3
from __future__ import annotations

import argparse
from datetime import datetime, timedelta, timezone

from _stage_b_api import api_call, current_session, print_json


def _ttl_to_iso(ttl: int | None) -> str | None:
    if ttl is None:
        return None
    return (datetime.now(timezone.utc) + timedelta(seconds=ttl)).isoformat()


def cmd_set(args: argparse.Namespace) -> None:
    session = args.session or current_session()
    payload = {
        "pause_source": "cli",
        "pause_reason": args.reason or "",
        "pause_expires_at": _ttl_to_iso(args.ttl),
        "paused_by": session,
    }
    print_json(api_call("POST", f"/api/sessions/{session}/pause", payload))


def cmd_clear(args: argparse.Namespace) -> None:
    session = args.session or current_session()
    print_json(api_call("DELETE", f"/api/sessions/{session}/pause", {"from": session}))


def cmd_status(args: argparse.Namespace) -> None:
    session = args.session or current_session()
    print_json({
        "session": session,
        "note": "Pause status is not exposed by a dedicated Stage A GET endpoint; inspect stop-status and recent CLI actions.",
        "stop_status": api_call("GET", f"/api/sessions/{session}/stop-status"),
    })


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command")

    p_set = sub.add_parser("set")
    p_set.add_argument("--reason", default="")
    p_set.add_argument("--ttl", type=int, default=None)
    p_set.add_argument("--session", default=None)
    p_set.set_defaults(func=cmd_set)

    p_clear = sub.add_parser("clear")
    p_clear.add_argument("--session", default=None)
    p_clear.set_defaults(func=cmd_clear)

    p_status = sub.add_parser("status")
    p_status.add_argument("--session", default=None)
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.error("choose set, clear, or status")
    args.func(args)


if __name__ == "__main__":
    main()
