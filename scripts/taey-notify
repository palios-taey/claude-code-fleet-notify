#!/usr/bin/env python3
"""
Send a notification to a Claude instance's Redis inbox.

This is a PURE SENDER — writes to Redis and exits.
Delivery is handled automatically by:
  - PostToolUse hook (drains inbox during active tool use)
  - notify-deliver daemon (injects via tmux when target is idle)

Usage:
    taey-notify <target-node> "message"
    taey-notify <target-node> --body-file /path/to/message.txt
    taey-notify "DEFECT: scoped issue" --type defect
    taey-notify <target-node> "ESCALATION: something broke" --type escalation
    taey-notify <target-node> "cycle done" --type heartbeat --priority low
"""
import argparse
import json
import os
import subprocess
import sys
import time
import uuid

# Symlink-safe repo-root bootstrap (matches taey-handoff): the --handoff path
# lazily imports `notifications.handoff`, which fails with ModuleNotFoundError
# when this CLI is invoked via its /usr/local/bin symlink (sys.path[0] is the
# symlink's dir). realpath resolves to the real scripts/ dir; parent = repo.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

REDIS_HOST = os.environ.get('REDIS_HOST', '127.0.0.1')
REDIS_PORT = int(os.environ.get('REDIS_PORT', '6379'))
NOTIFY_KEY_PREFIX = os.environ.get('NOTIFY_KEY_PREFIX', 'taey')
DEFAULT_TARGET_TYPES = {'defect', 'response_ready', 'result', 'status', 'escalation'}


def detect_from_node():
    """Auto-detect sender identity."""
    explicit = os.environ.get('TAEY_NODE_ID')
    if explicit:
        return explicit
    try:
        result = subprocess.run(
            ['tmux', 'display-message', '-p', '#S'],
            capture_output=True, text=True, timeout=2,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except Exception:
        pass
    import socket
    return socket.gethostname()


def detect_execution_principal():
    """Return the process-bound caller class used for sender policy."""
    pid = os.getppid()
    for _ in range(16):
        if pid <= 1:
            break
        try:
            proc_root = f'/proc/{pid}'
            with open(f'{proc_root}/comm', encoding='utf-8') as handle:
                comm = handle.read().strip()
            with open(f'{proc_root}/cmdline', 'rb') as handle:
                cmdline = handle.read().split(b'\0', 1)[0]
            executable = os.path.basename(os.fsdecode(cmdline)) if cmdline else ''
            if comm == 'grok' or executable == 'grok':
                return 'grok'
            with open(f'{proc_root}/status', encoding='utf-8') as handle:
                parent_line = next(
                    line for line in handle if line.startswith('PPid:')
                )
            pid = int(parent_line.split(':', 1)[1].strip())
        except (OSError, StopIteration, ValueError):
            break

    tmux_pane = os.environ.get('TMUX_PANE') if os.environ.get('TMUX') else None
    if tmux_pane:
        try:
            result = subprocess.run(
                ['tmux', 'display-message', '-p', '-t', tmux_pane, '#S'],
                capture_output=True, text=True, timeout=2,
            )
            if result.returncode == 0 and result.stdout.strip():
                return result.stdout.strip()
        except Exception:
            pass
    return ''


def resolve_target_and_message(args, from_node, redis_client):
    if args.body_file is not None:
        if args.message is not None:
            print("ERROR: pass either a positional message or --body-file, not both", file=sys.stderr)
            sys.exit(2)
        try:
            with open(args.body_file, encoding="utf-8") as handle:
                return args.target_or_message, handle.read()
        except OSError as exc:
            print(f"ERROR: cannot read --body-file {args.body_file}: {exc}", file=sys.stderr)
            sys.exit(2)
    if args.message is not None:
        return args.target_or_message, args.message
    if args.type not in DEFAULT_TARGET_TYPES:
        print(
            "ERROR: target is required for this message type. "
            "For peer defect/status/result reports, use --type defect/status/result "
            "or set NOTIFY_TARGET explicitly.",
            file=sys.stderr,
        )
        sys.exit(2)

    from notifications.targets import default_notify_target

    target = default_notify_target(
        redis_client,
        from_node,
        explicit_target=os.environ.get("NOTIFY_TARGET"),
        prefix=args.key_prefix,
    )
    if not target:
        print(
            "ERROR: target omitted and no NOTIFY_TARGET or parent session resolved. "
            "Pass an explicit target or set taey:<node>:parent.",
            file=sys.stderr,
        )
        sys.exit(2)
    return target, args.target_or_message


def main():
    parser = argparse.ArgumentParser(
        description="Send notification to a Claude instance's Redis inbox",
    )
    parser.add_argument('target_or_message',
                        help='Target node ID, or message body for peer report types')
    parser.add_argument('message', nargs='?', help='Message body')
    parser.add_argument('--body-file', default=None,
                        help='Read the message body from a UTF-8 file instead of argv')
    parser.add_argument('--type', '-t', default='message',
                        choices=['message', 'escalation', 'heartbeat', 'notification',
                                 'response_ready', 'command', 'defect', 'task',
                                 'status', 'directive', 'result', 'wake'],
                        help='Message type (default: message)')
    parser.add_argument('--priority', '-p', default='normal',
                        choices=['high', 'normal', 'low'],
                        help='Priority level (default: normal)')
    parser.add_argument('--from', dest='from_node', default=None,
                        help='Sender ID (auto-detected if omitted)')
    parser.add_argument('--redis-host', default=REDIS_HOST)
    parser.add_argument('--redis-port', type=int, default=REDIS_PORT)
    parser.add_argument('--key-prefix', default=NOTIFY_KEY_PREFIX,
                        help='Redis key prefix (default: NOTIFY_KEY_PREFIX or taey)')
    parser.add_argument('--handoff', action='store_true',
                        help='Create an explicit handoff record plus inbox message')
    parser.add_argument('--dispatcher-task-id', default=None,
                        help='Dispatcher task id for explicit handoff records')
    parser.add_argument('--actionable-inputs', default=None,
                        help='JSON object written into the explicit handoff record')
    parser.add_argument('--ack-deadline-secs', type=int, default=300,
                        help='Long safety backstop in seconds for explicit handoffs; short pickup window comes from CF_HANDOFF_PICKUP_POLL_BUDGET (default: 300)')
    parser.add_argument('--allow-unregistered-target', '--allow-readerless-target',
                        dest='allow_unregistered_target', action='store_true',
                        help='Explicitly allow an intentional pre-provisioning send to an unregistered/readerless target when policy permits')
    args = parser.parse_args()

    from_node = args.from_node or detect_from_node()
    execution_principal = detect_execution_principal()

    if (
        execution_principal == 'grok'
        or execution_principal.endswith('-grok')
    ) and args.type == 'message':
        print(
            "ERROR: Grok peer notifications must be actionable and typed; "
            "use defect, response_ready, result, status, or escalation, and "
            "aggregate one terminal parent notification per task.",
            file=sys.stderr,
        )
        sys.exit(2)

    if args.type == 'escalation' and args.priority == 'normal':
        args.priority = 'high'

    try:
        import redis
    except ImportError:
        print("ERROR: redis-py not installed. Run: pip install redis", file=sys.stderr)
        sys.exit(1)

    r = redis.Redis(
        host=args.redis_host, port=args.redis_port,
        decode_responses=True, socket_timeout=2,
    )

    try:
        r.ping()
    except Exception as e:
        print(f"ERROR: Cannot connect to Redis at {args.redis_host}:{args.redis_port}: {e}",
              file=sys.stderr)
        sys.exit(1)
    target, message = resolve_target_and_message(args, from_node, r)
    if not args.allow_unregistered_target:
        from notifications.targets import validate_target_reader

        allowed, reason = validate_target_reader(
            r,
            target,
            args.key_prefix,
            from_node=from_node,
            msg_type=args.type,
            body=message,
            explicit_handoff=args.handoff,
        )
        if not allowed:
            print(reason, file=sys.stderr)
            sys.exit(1)

    # P0 safety (task-f396305d): revoke worker outward notify after unbind.
    # Prefers orch authorize_outward_capability (shared with GitHub); else Redis current_task.
    from notifications.outward_capability_gate import (
        OutwardNotifyDenied,
        require_outward_notify_capability,
    )

    try:
        require_outward_notify_capability(
            from_node,
            args.type,
            r,
            key_prefix=args.key_prefix,
        )
    except OutwardNotifyDenied as exc:
        print(f"SAFETY DENY: {exc}", file=sys.stderr)
        sys.exit(1)

    if args.handoff:
        from notifications.handoff import create_explicit_handoff

        actionable_inputs = {}
        if args.actionable_inputs:
            try:
                actionable_inputs = json.loads(args.actionable_inputs)
            except json.JSONDecodeError as exc:
                print(f"ERROR: --actionable-inputs must be valid JSON: {exc}", file=sys.stderr)
                sys.exit(1)
            if not isinstance(actionable_inputs, dict):
                print("ERROR: --actionable-inputs must decode to a JSON object", file=sys.stderr)
                sys.exit(1)
        payload = create_explicit_handoff(
            r,
            prefix=args.key_prefix,
            dispatcher_session_id=from_node,
            target_session_id=target,
            body=message,
            msg_type=args.type,
            priority=args.priority,
            dispatcher_task_id=args.dispatcher_task_id,
            actionable_inputs=actionable_inputs,
            ack_deadline_secs=args.ack_deadline_secs,
        )
        msg_id = payload["msg_id"]
    else:
        msg = json.dumps({
            "from": from_node,
            "type": args.type,
            "body": message,
            "timestamp": time.time(),
            "priority": args.priority,
            "msg_id": uuid.uuid4().hex[:12],
        })
        r.lpush(f"{args.key_prefix}:{target}:inbox", msg)
        msg_id = json.loads(msg)["msg_id"]
    try:
        r.xadd(
            f"{args.key_prefix}:notify_trace",
            {"ev": "enqueue", "node": target, "src": "taey-notify",
             "type": args.type, "frm": from_node, "wall": f"{time.time():.3f}", "msg_id": msg_id},
            maxlen=50000, approximate=True,
        )
    except Exception:
        pass
    print(f"OK: sent to {target} [{args.type}] from {from_node}")


if __name__ == '__main__':
    main()
