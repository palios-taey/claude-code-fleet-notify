#!/usr/bin/env python3
from __future__ import annotations

import argparse

from _stage_b_api import api_call, print_json, resolve_condition


def cmd_list(args: argparse.Namespace) -> None:
    result = api_call("GET", f"/api/projects/{args.project_id}")
    print_json({"project_id": args.project_id, "conditions": result["project"].get("user_stop_conditions", [])})


def cmd_add(args: argparse.Namespace) -> None:
    result = api_call("POST", f"/api/projects/{args.project_id}/conditions", {"label": args.label, "from": "taey-conditions"})
    print_json(result)


def cmd_edit(args: argparse.Namespace) -> None:
    project = api_call("GET", f"/api/projects/{args.project_id}")
    condition = resolve_condition(project, args.condition_id)
    result = api_call(
        "PATCH",
        f"/api/projects/{args.project_id}/conditions/{condition['id']}",
        {"label": args.label, "from": "taey-conditions"},
    )
    print_json(result)


def cmd_deprecate(args: argparse.Namespace) -> None:
    raise SystemExit("Condition deprecate is not exposed by the current Stage A API")


def main() -> None:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command")

    p_list = sub.add_parser("list")
    p_list.add_argument("project_id")
    p_list.set_defaults(func=cmd_list)

    p_add = sub.add_parser("add")
    p_add.add_argument("project_id")
    p_add.add_argument("--label", required=True)
    p_add.set_defaults(func=cmd_add)

    p_edit = sub.add_parser("edit")
    p_edit.add_argument("project_id")
    p_edit.add_argument("--condition-id", required=True)
    p_edit.add_argument("--label", required=True)
    p_edit.set_defaults(func=cmd_edit)

    p_deprecate = sub.add_parser("deprecate")
    p_deprecate.add_argument("project_id")
    p_deprecate.add_argument("--condition-id", required=True)
    p_deprecate.set_defaults(func=cmd_deprecate)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.error("choose list, add, edit, or deprecate")
    args.func(args)


if __name__ == "__main__":
    main()
