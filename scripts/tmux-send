#!/bin/bash
# tmux-send: Send text + submit to a hookable REPL CLI tmux session.
# Usage: tmux-send <host> <session> "message text"
#        tmux-send <session> <message>  (local shorthand)
#
# Per-CLI submit strategy (auto-detected from session-name suffix):
#
# Claude Code / codex (Ink TUI with Kitty keyboard protocol):
#   Enter = ESC[13u (CSI u), not legacy 0x0D. Sequence:
#     1. Ctrl-U + Ctrl-K     — clear any prior content in the input box
#     2. Type message
#     3. Escape              — dismiss autocomplete overlay (safe here)
#     4. legacy Enter        — 0x0D (works when autocomplete is gone)
#     5. CSI u Enter         — ESC[13u via send-keys -H (Kitty)
#
# Grok-Build (modal TUI — "Enter:send" vs "→:expand" modes):
#   CRITICAL: do NOT send Escape — it toggles modes mid-sequence and
#   breaks submit. Also do NOT send CSI u Enter — in input-ready mode
#   it toggles to viewing-thinking mode instead of submitting. Sequence:
#     1. Ctrl-U + Ctrl-K     — clear any prior content (prevents
#                              accumulating injections on re-poll if
#                              prior submit didn't land)
#     2. Type message
#     3. legacy Enter        — plain 0x0D submits when grok is in
#                              input-ready mode (hint line shows
#                              "Enter:send"). Verified live 2026-05-26.
#
# Detection: session-name suffix. Anything ending in -grok uses the
# grok sequence; everything else uses the Claude Code / codex sequence.
# Override via SEND_SEQUENCE env: SEND_SEQUENCE=grok or =claude.
#
# See: github.com/anthropics/claude-code/issues/15553

set -euo pipefail

if [ $# -eq 2 ]; then
    HOST="local"
    SESSION="$1"
    MSG="$2"
elif [ $# -ge 3 ]; then
    HOST="$1"
    SESSION="$2"
    shift 2
    MSG="$*"
else
    echo "Usage: tmux-send <host> <session> <message>" >&2
    echo "       tmux-send <session> <message>  (local)" >&2
    exit 1
fi

# Detect per-CLI submit sequence.
detect_sequence() {
    local sess="$1"
    if [ -n "${SEND_SEQUENCE:-}" ]; then
        echo "$SEND_SEQUENCE"
        return
    fi
    case "$sess" in
        *-grok) echo "grok" ;;
        *)      echo "claude" ;;
    esac
}

SEQ=$(detect_sequence "$SESSION")
SUBMIT_VERIFY_RETRIES="${SUBMIT_VERIFY_RETRIES:-2}"
SUBMIT_VERIFY_SETTLE_SECS="${SUBMIT_VERIFY_SETTLE_SECS:-0.25}"

composer_text_from_pane() {
    python3 -c '
import sys

pane = sys.stdin.read()
markers = ("❯", "›")
ignored_prefixes = (
    "use /skills to list available skills",
    "how is claude doing this session?",
)

def strip_box_edges(line):
    text = line.strip()
    if text.startswith("│"):
        text = text[1:]
    if text.endswith("│"):
        text = text[:-1]
    return text.strip()

def usable(text):
    candidate = " ".join(str(text or "").split())
    if not candidate:
        return ""
    lowered = candidate.lower()
    if any(lowered.startswith(prefix) for prefix in ignored_prefixes):
        return ""
    return candidate

def marker_position(inner):
    positions = [(inner.find(marker), marker) for marker in markers if marker in inner]
    positions = [(pos, marker) for pos, marker in positions if pos >= 0]
    if not positions:
        return None
    return min(positions, key=lambda item: item[0])

def text_from_box_lines(box_lines):
    for index, raw_line in enumerate(box_lines):
        inner = strip_box_edges(raw_line)
        found = marker_position(inner)
        if found is None:
            continue
        marker_pos, marker = found
        inline = usable(inner[marker_pos + len(marker):])
        if inline:
            print(inline[:160])
            raise SystemExit(0)
        for continuation in box_lines[index + 1:]:
            text = usable(strip_box_edges(continuation))
            if text:
                print(text[:160])
                raise SystemExit(0)
        raise SystemExit(0)

recent = [line for line in pane.splitlines() if line.strip()][-12:]
box_lines = []
in_box = False
for raw_line in reversed(recent):
    stripped = raw_line.strip()
    if not in_box:
        if stripped.startswith("╰") and stripped.endswith("╯"):
            in_box = True
        continue
    if stripped.startswith("╭") and stripped.endswith("╮"):
        text_from_box_lines(list(reversed(box_lines)))
        raise SystemExit(0)
    if stripped.startswith("│") and stripped.endswith("│"):
        box_lines.append(raw_line)

for index in range(len(recent) - 1, -1, -1):
    raw_line = recent[index]
    inner = strip_box_edges(raw_line)
    found = marker_position(inner)
    if found is None:
        continue
    marker_pos, marker = found
    inline = usable(inner[marker_pos + len(marker):])
    if inline:
        print(inline[:160])
        raise SystemExit(0)
    if not raw_line.strip().startswith("│"):
        continue
    for continuation in recent[index + 1:]:
        continuation_inner = strip_box_edges(continuation)
        if marker_position(continuation_inner) is not None:
            break
        text = usable(continuation_inner)
        if text:
            print(text[:160])
            raise SystemExit(0)
'
}

resend_submit() {
    if [ "$SEQ" = "grok" ]; then
        tmux send-keys -t "$SESSION" Enter
    else
        tmux send-keys -t "$SESSION" Enter
        sleep 0.1
        tmux send-keys -t "$SESSION" -H 1b 5b 31 33 75
    fi
}

verify_submission_consumed() {
    local attempt=0
    local pane=""
    local composer=""
    while [ "$attempt" -le "$SUBMIT_VERIFY_RETRIES" ]; do
        if ! pane="$(tmux capture-pane -p -t "$SESSION" -S -80)"; then
            echo "ERROR: $SESSION submit verification failed: capture-pane failed" >&2
            return 1
        fi
        composer="$(printf '%s' "$pane" | composer_text_from_pane)"
        if [ -z "$composer" ]; then
            return 0
        fi
        if [ "$attempt" -ge "$SUBMIT_VERIFY_RETRIES" ]; then
            echo "ERROR: $SESSION submit verification failed: composer still occupied after $SUBMIT_VERIFY_RETRIES retries" >&2
            return 1
        fi
        echo "WARN: $SESSION submit verification found stranded composer text; retrying submit ($((attempt + 1))/$SUBMIT_VERIFY_RETRIES)" >&2
        resend_submit
        sleep "$SUBMIT_VERIFY_SETTLE_SECS"
        attempt=$((attempt + 1))
    done
    return 1
}

# Local send
if [ "$HOST" = "local" ] || [ "$HOST" = "localhost" ] || [ "$HOST" = "$(hostname -s)" ]; then
    # Pre-clear the input box for both sequences. Without this, a re-poll
    # injection on a stuck session accumulates text (verified live
    # 2026-05-26: x-claude-grok had three concatenated NOTIFY messages
    # because the daemon kept re-injecting without clearing).
    tmux send-keys -t "$SESSION" C-u C-k
    sleep 0.1

    if [ "$SEQ" = "grok" ]; then
        # Grok modal TUI: Enter = SUBMIT. Embedded \n in $MSG sent via
        # send-keys would fragment a multi-line dispatch into multiple
        # partial submits (verified live 2026-05-31: 7-attack-vector audit
        # prompt got chopped per line, left trailing fragment in input
        # box, grok never received the full prompt). Use bracketed paste
        # so the TUI inserts the whole block as text without interpreting
        # embedded newlines as Enter. Then plain Enter submits.
        printf '%s' "$MSG" | tmux load-buffer -
        tmux paste-buffer -t "$SESSION" -p -d
        sleep 0.5
        tmux send-keys -t "$SESSION" Enter
        sleep "$SUBMIT_VERIFY_SETTLE_SECS"
    else
        # Claude Code / codex (Ink TUI / Kitty protocol): embedded \n is
        # newline-in-input not submit, so direct send-keys is fine.
        tmux send-keys -t "$SESSION" -- "$MSG"
        sleep 0.5
        tmux send-keys -t "$SESSION" Escape
        sleep 0.2
        tmux send-keys -t "$SESSION" Enter
        sleep 0.1
        tmux send-keys -t "$SESSION" -H 1b 5b 31 33 75
        sleep "$SUBMIT_VERIFY_SETTLE_SECS"
    fi
    verify_submission_consumed
    echo "OK: $SESSION (local, sequence=$SEQ)"
    exit 0
fi

# Remote send via SSH — same per-CLI logic.
B64=$(printf '%s' "$MSG" | base64 -w0)
SESSION_B64=$(printf '%s' "$SESSION" | base64 -w0)
ssh "$HOST" "SESSION_B64='${SESSION_B64}' SEQ='${SEQ}' MSG_B64='${B64}' SUBMIT_VERIFY_RETRIES='${SUBMIT_VERIFY_RETRIES}' SUBMIT_VERIFY_SETTLE_SECS='${SUBMIT_VERIFY_SETTLE_SECS}' bash -s" <<'REMOTE_TMUX_SEND'
set -euo pipefail

SESSION=$(printf '%s' "$SESSION_B64" | base64 -d)
MSG=$(printf '%s' "$MSG_B64" | base64 -d)

composer_text_from_pane() {
    python3 -c '
import sys

pane = sys.stdin.read()
markers = ("❯", "›")
ignored_prefixes = (
    "use /skills to list available skills",
    "how is claude doing this session?",
)

def strip_box_edges(line):
    text = line.strip()
    if text.startswith("│"):
        text = text[1:]
    if text.endswith("│"):
        text = text[:-1]
    return text.strip()

def usable(text):
    candidate = " ".join(str(text or "").split())
    if not candidate:
        return ""
    lowered = candidate.lower()
    if any(lowered.startswith(prefix) for prefix in ignored_prefixes):
        return ""
    return candidate

def marker_position(inner):
    positions = [(inner.find(marker), marker) for marker in markers if marker in inner]
    positions = [(pos, marker) for pos, marker in positions if pos >= 0]
    if not positions:
        return None
    return min(positions, key=lambda item: item[0])

def text_from_box_lines(box_lines):
    for index, raw_line in enumerate(box_lines):
        inner = strip_box_edges(raw_line)
        found = marker_position(inner)
        if found is None:
            continue
        marker_pos, marker = found
        inline = usable(inner[marker_pos + len(marker):])
        if inline:
            print(inline[:160])
            raise SystemExit(0)
        for continuation in box_lines[index + 1:]:
            text = usable(strip_box_edges(continuation))
            if text:
                print(text[:160])
                raise SystemExit(0)
        raise SystemExit(0)

recent = [line for line in pane.splitlines() if line.strip()][-12:]
box_lines = []
in_box = False
for raw_line in reversed(recent):
    stripped = raw_line.strip()
    if not in_box:
        if stripped.startswith("╰") and stripped.endswith("╯"):
            in_box = True
        continue
    if stripped.startswith("╭") and stripped.endswith("╮"):
        text_from_box_lines(list(reversed(box_lines)))
        raise SystemExit(0)
    if stripped.startswith("│") and stripped.endswith("│"):
        box_lines.append(raw_line)

for index in range(len(recent) - 1, -1, -1):
    raw_line = recent[index]
    inner = strip_box_edges(raw_line)
    found = marker_position(inner)
    if found is None:
        continue
    marker_pos, marker = found
    inline = usable(inner[marker_pos + len(marker):])
    if inline:
        print(inline[:160])
        raise SystemExit(0)
    if not raw_line.strip().startswith("│"):
        continue
    for continuation in recent[index + 1:]:
        continuation_inner = strip_box_edges(continuation)
        if marker_position(continuation_inner) is not None:
            break
        text = usable(continuation_inner)
        if text:
            print(text[:160])
            raise SystemExit(0)
'
}

resend_submit() {
    if [ "$SEQ" = "grok" ]; then
        tmux send-keys -t "$SESSION" Enter
    else
        tmux send-keys -t "$SESSION" Enter
        sleep 0.1
        tmux send-keys -t "$SESSION" -H 1b 5b 31 33 75
    fi
}

verify_submission_consumed() {
    local attempt=0
    local pane=""
    local composer=""
    while [ "$attempt" -le "$SUBMIT_VERIFY_RETRIES" ]; do
        if ! pane="$(tmux capture-pane -p -t "$SESSION" -S -80)"; then
            echo "ERROR: $SESSION submit verification failed: capture-pane failed" >&2
            return 1
        fi
        composer="$(printf '%s' "$pane" | composer_text_from_pane)"
        if [ -z "$composer" ]; then
            return 0
        fi
        if [ "$attempt" -ge "$SUBMIT_VERIFY_RETRIES" ]; then
            echo "ERROR: $SESSION submit verification failed: composer still occupied after $SUBMIT_VERIFY_RETRIES retries" >&2
            return 1
        fi
        echo "WARN: $SESSION submit verification found stranded composer text; retrying submit ($((attempt + 1))/$SUBMIT_VERIFY_RETRIES)" >&2
        resend_submit
        sleep "$SUBMIT_VERIFY_SETTLE_SECS"
        attempt=$((attempt + 1))
    done
    return 1
}

tmux send-keys -t "$SESSION" C-u C-k
sleep 0.1

if [ "$SEQ" = 'grok' ]; then
    # Bracketed paste — see local-send branch above for full reasoning.
    printf '%s' "$MSG" | tmux load-buffer -
    tmux paste-buffer -t "$SESSION" -p -d
    sleep 0.5
    tmux send-keys -t "$SESSION" Enter
    sleep "$SUBMIT_VERIFY_SETTLE_SECS"
else
    tmux send-keys -t "$SESSION" -- "$MSG"
    sleep 0.5
    tmux send-keys -t "$SESSION" Escape
    sleep 0.2
    tmux send-keys -t "$SESSION" Enter
    sleep 0.1
    tmux send-keys -t "$SESSION" -H 1b 5b 31 33 75
    sleep "$SUBMIT_VERIFY_SETTLE_SECS"
fi
verify_submission_consumed
REMOTE_TMUX_SEND

echo "OK: $SESSION (sequence=$SEQ)"
