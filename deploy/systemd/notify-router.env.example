# Copy to:
#   ~/.config/claude-code-fleet-notify/notify-router.env
#
# These values launch conductor-notify-router.service. The unit requires every
# key below and fails before exec if any are unset.
NOTIFY_REPO_ROOT=/absolute/path/to/claude-code-fleet-notify
NOTIFY_PYTHON=/usr/bin/python3
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
NOTIFY_KEY_PREFIX=taey
# Optional opt-in. Unset/blank keeps legacy suffix-strip (base Claude is the
# supervisor). When set, every entry must be a *-codex session; those nodes
# become top-level supervisors and matching base Claude / *-gemini / *-grok
# workers resolve to them. Malformed values fail daemon startup.
# NOTIFY_SUPERVISOR_IDS=conductor-codex,weaver-codex
