# Copy to:
#   ~/.config/claude-code-fleet-notify/notify-router.env
#
# These values launch conductor-notify-router.service. The unit requires every
# key below and fails before exec if any are unset.
NOTIFY_REPO_ROOT=/absolute/path/to/claude-code-fleet-notify
NOTIFY_PYTHON=/usr/bin/python3
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
NOTIFY_KEY_PREFIX=taey
