{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CF_NOTIFY_HOOK_ROOT:-$HOME/.local/share/claude-code-fleet-notify/hooks-runtime/hooks}/grok_session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CF_NOTIFY_HOOK_ROOT:-$HOME/.local/share/claude-code-fleet-notify/hooks-runtime/hooks}/grok_stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CF_NOTIFY_HOOK_ROOT:-$HOME/.local/share/claude-code-fleet-notify/hooks-runtime/hooks}/grok_user_prompt.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
